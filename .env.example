# ── YouTube Song Bot — environment template ─────────────────────────────
# Copy to .env for local dev. On Render, set these in Dashboard → Environment.
# NEVER commit real values to git.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required (webhook mode): public base URL, no trailing slash
# Example: https://youtube-song-bot.onrender.com
BASE_URL=

# Webhook security: must match the URL path Telegram posts to
WEBHOOK_SECRET=change-me-secret

# Webhook vs polling. Render/free hosting → true (incoming messages wake the app)
USE_WEBHOOK=true

# Restrict bot to one Telegram numeric user ID (send /id to the bot to find yours)
AUTHORIZED_TELEGRAM_USER_ID=

# Default YouTube privacy for uploads: private | unlisted | public
DEFAULT_PRIVACY=private

# Google OAuth client JSON (Web application type) as a single-line JSON string.
# Redirect URI in Google Cloud Console must be: ${BASE_URL}/oauth2callback
GOOGLE_CLIENT_SECRETS_JSON={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase/Neon) for persistent storage. If unset, bot falls back
# to ephemeral SQLite at storage/trends.db (data lost on Render redeploy).
# NOTE: Render is IPv4-only — use the Supabase IPv4 pooler URL (port 6543),
# NOT the direct db.*.supabase.co URL (IPv6-only, unreachable from Render).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── GitHub Actions worker (heavy render/upload offload) ─────────────────────
USE_GITHUB_WORKER=true
GITHUB_REPO=lovesongs1106-creator/youtube-song-bot
GITHUB_TOKEN=
GITHUB_EVENT_TYPE=render_video

# ── Audio download chain ────────────────────────────────────────────────────
# Cobalt API tried first, yt-dlp fallback second. Self-host or point at a
# working instance; the public api.cobalt.tools endpoint is often unavailable.
COBALT_API_URL=https://cobalt.example.com/

# Netscape-format YouTube cookies, used by yt-dlp fallback for age-gated /
# login-gated videos. GitHub Actions secret YOUTUBE_COOKIES in worker.
YOUTUBE_COOKIES=

# ── Facebook → second YouTube channel (GitHub Actions side) ────────────────
# These live in GitHub repo Secrets/Variables, NOT in Render env — the bot
# only dispatches jobs; the worker reads these. Documented here for setup.
#
# Secrets (Settings → Secrets and variables → Actions → Secrets):
#   YOUTUBE_SECOND_CLIENT_ID=        OAuth client ID for the 2nd channel's Google account
#   YOUTUBE_SECOND_CLIENT_SECRET=    OAuth client secret
#   YOUTUBE_SECOND_REFRESH_TOKEN=    Long-lived refresh token (see FACEBOOK_SECOND_CHANNEL_SETUP.md)
#
# Variables (same page → Variables tab):
#   YOUTUBE_TARGET_CHANNEL=second
#   YOUTUBE_VISIBILITY=private        private | unlisted | public (default private)
#   OUTRO_ASSET_PATH=assets/outro.mp4
#
# Repo file required: assets/outro.mp4 (fixed outro appended to every FB job)

# ── Hosting ────────────────────────────────────────────────────────────────
PORT=8080
